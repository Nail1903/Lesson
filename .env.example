# ─────────────────────────────────────────────────────────────
#  MyLesson — environment variables
#  Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

# --- Database (Neon / any PostgreSQL 15+ with the `vector` extension) ---
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.eu-central-1.aws.neon.tech/mylesson?sslmode=require"
# Direct (non-pooled) connection string used by `prisma migrate`.
DIRECT_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/mylesson?sslmode=require"

# --- Auth.js / NextAuth ---
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET="replace-me-with-a-long-random-string"
# Public URL of the app. Required in production.
AUTH_URL="http://localhost:3000"
# Set to "true" to allow the seeded demo account to sign in from the login page.
DEMO_MODE="true"
DEMO_EMAIL="demo@mylesson.app"
DEMO_PASSWORD="demo1234"

# --- AI provider ---
# Which provider the server uses for chat + embeddings. One of: openai | anthropic | echo
# `echo` is an offline stub provider — no API key needed, useful for local dev/tests.
AI_PROVIDER="openai"

# Chat model per provider (used when AI_PROVIDER matches).
OPENAI_API_KEY=""
OPENAI_CHAT_MODEL="gpt-4o-mini"
OPENAI_EMBEDDING_MODEL="text-embedding-3-small"
OPENAI_EMBEDDING_DIMENSIONS="1536"

ANTHROPIC_API_KEY=""
ANTHROPIC_CHAT_MODEL="claude-sonnet-5"
# Anthropic has no embeddings endpoint — embeddings always fall back to this provider:
EMBEDDING_PROVIDER="openai"

# --- Rate limiting (per user, sliding window, in-memory by default) ---
RATE_LIMIT_AI_PER_MINUTE="15"
RATE_LIMIT_UPLOAD_PER_MINUTE="30"

# --- File storage adapter: local | s3 ---
STORAGE_DRIVER="local"
# local driver:
STORAGE_LOCAL_DIR="./uploads"
# s3 driver (also works with Cloudflare R2 / MinIO via STORAGE_S3_ENDPOINT):
STORAGE_S3_BUCKET=""
STORAGE_S3_REGION="auto"
STORAGE_S3_ENDPOINT=""
STORAGE_S3_ACCESS_KEY_ID=""
STORAGE_S3_SECRET_ACCESS_KEY=""
STORAGE_S3_PUBLIC_URL=""

# --- Upload limits ---
MAX_UPLOAD_MB="20"
ALLOWED_UPLOAD_TYPES="application/pdf,text/plain,text/markdown,text/csv,image/png,image/jpeg,image/webp,application/vnd.openxmlformats-officedocument.wordprocessingml.document"

# --- App ---
NODE_ENV="development"
LOG_LEVEL="info"
